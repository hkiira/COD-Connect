		{
			"name": "Create Order",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{bearer_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"John Doe\",\n  \"phoneNumber\": \"0612345678\",\n  \"city_id\": 4,\n  \"address\": \"123 Rue de la Liberté\",\n  \"products\": [\n    {\n      \"id\": 45,\n      \"quantity\": 2\n    },\n    {\n      \"id\": 78,\n      \"quantity\": 1\n    }\n  ],\n  \"final_price\": 350.00,\n  \"brand_source_id\": 108\n}"
				},
				"url": {
					"raw": "{{base_url}}/next/create_order",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"next",
						"create_order"
					]
				},
				"description": "Creates a new system order using a flat customer structure and scales product pricing to match the total final_price."
			},
			"response": []
		},
